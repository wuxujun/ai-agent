# Copy to .env (`cp .env.example .env`). The Makefile and docker compose read it.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki
POSTGRES_DB=wiki
POSTGRES_PORT=5432

# --- Server ---
HTTP_ADDR=:8080
HTTP_PORT=8080
SHUTDOWN_TIMEOUT=15s
# Used by `make run` (host) and integration tests. Compose overrides it for the container.
DATABASE_URL=postgres://wiki:wiki@localhost:5432/wiki?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_CONNECT_TIMEOUT=30s
# Apply embedded migrations at startup (compose runs the migrate service instead).
MIGRATE_ON_START=false

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# --- Validation Gateway ---
VALIDATION_MIN_CONFIDENCE=0.7
VALIDATION_MAX_AGE=720h

# --- Retrieval / orchestration ---
SEARCH_LIMIT=5
# Maximum cosine distance (0 disables the cut-off).
SEARCH_MAX_DISTANCE=0
ORCHESTRATOR_MAX_ITERATIONS=3

# --- Tests ---
# Admin DSN; each integration test creates and drops its own database.
TEST_DATABASE_URL=postgres://wiki:wiki@localhost:5432/wiki?sslmode=disable
