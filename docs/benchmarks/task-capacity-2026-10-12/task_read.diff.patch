+// summaryPageHeap keeps the oldest selected row at the root, so retaining
+// the newest limit rows needs only O(limit) temporary storage.
+type summaryPageHeap []TaskSummary
+
+func (h summaryPageHeap) Len() int { return len(h) }
+func (h summaryPageHeap) LessSummary(a, b TaskSummary) bool {
+	return a.CreatedAt.Before(b.CreatedAt) || a.CreatedAt.Equal(b.CreatedAt) && a.ID < b.ID
+}
+func (h summaryPageHeap) Less(i, j int) bool { return h.LessSummary(h[i], h[j]) }
+func (h summaryPageHeap) Swap(i, j int)      { h[i], h[j] = h[j], h[i] }
+func (h *summaryPageHeap) Push(value any)    { *h = append(*h, value.(TaskSummary)) }
+func (h *summaryPageHeap) Pop() any {
+	old := *h
+	value := old[len(old)-1]
+	*h = old[:len(old)-1]
+	return value
+}
