# Copy this file to deploy/litellm/.env and replace every example secret.
# Keep LITELLM_SALT_KEY unchanged after first startup: LiteLLM uses it to
# encrypt provider credentials stored through the Admin UI.

# Keep the bundled database active for both `up` and `down`.
COMPOSE_PROFILES=bundled-db

LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=change-me-to-a-long-random-value
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me

POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me
# PostgreSQL is host-accessible on loopback by default. For remote access,
# prefer the server's private/VPN address. Use 0.0.0.0 only with a restrictive
# firewall or security group that allows TCP from trusted source IPs.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# To use an existing PostgreSQL server instead of the bundled-db profile,
# uncomment this value. For a database running on the Docker host, use
# host.docker.internal and its host-side port.
# LITELLM_DATABASE_URL=postgresql://litellm:change-me@host.docker.internal:55432/litellm

# DashScope credentials used by the seeded Qwen models.
DASHSCOPE_API_KEY=
# China/Beijing endpoint. Change this for another DashScope region.
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional legacy providers used by the cross-provider fallback aliases.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=

# Optional Groq provider. Override GROQ_API_BASE when routing Groq requests
# through a compatible private endpoint or network proxy.
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1

# Optional xAI provider.
XAI_API_KEY=
XAI_API_BASE=https://api.x.ai/v1

# Optional NVIDIA NIM provider.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1

# Optional SMTP notifications. Tencent Exmail uses implicit SSL on port 465.
# SMTP_USERNAME and SMTP_SENDER_EMAIL should normally be the same complete
# enterprise email address. Use a client-specific password when available.
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_TLS=False
SMTP_USE_SSL=True
# Do not include newly-created virtual API keys in notification emails.
LITELLM_EMAIL_INCLUDE_API_KEY=False
# Public LiteLLM Proxy URL used by the Admin UI and notification links.
# For a subpath deployment, set both values and omit the trailing slash:
# SERVER_ROOT_PATH=/litellm
# PROXY_BASE_URL=https://gateway.example.com/litellm
SERVER_ROOT_PATH=
PROXY_BASE_URL=http://127.0.0.1:4000

# The gateway is bound to localhost by default.
LITELLM_BIND_ADDRESS=127.0.0.1
LITELLM_PORT=4000

# Local resource ceilings. Increase the LiteLLM memory limit if large request
# concurrency or additional proxy features require it.
LITELLM_CPU_LIMIT=1.0
LITELLM_MEMORY_LIMIT=2g
LITELLM_PIDS_LIMIT=128
LITELLM_BOOTSTRAP_CPU_LIMIT=0.25
LITELLM_BOOTSTRAP_MEMORY_LIMIT=128m
LITELLM_BOOTSTRAP_PIDS_LIMIT=32
POSTGRES_CPU_LIMIT=0.5
POSTGRES_MEMORY_LIMIT=256m
POSTGRES_PIDS_LIMIT=128

# Reconcile seed models into PostgreSQL. Missing deployments are created and
# declared litellm_params are patched when they differ from the manifest.
# Reconcile both baseline aliases and the additional Qwen deployments. A
# comma-separated list takes precedence over the legacy singular variable.
LITELLM_MODEL_BOOTSTRAP_MANIFESTS=/bootstrap/bootstrap-models.json,/bootstrap/qwen-models.json
# LITELLM_MODEL_BOOTSTRAP_MANIFEST=/bootstrap/bootstrap-models.json
LITELLM_MODEL_BOOTSTRAP_INTERVAL_SECONDS=60
LITELLM_MODEL_BOOTSTRAP_TIMEOUT_SECONDS=10

# Override only when deliberately upgrading and testing images.
# LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
# POSTGRES_IMAGE=postgres:16-alpine
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
# Base host only. Do not append /api/public/otel for LiteLLM's langfuse_otel callback.
LANGFUSE_OTEL_HOST=https://langfuse.example.com
