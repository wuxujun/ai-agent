# Copy this file to deploy/litellm/.env and replace every example secret.
# Keep LITELLM_SALT_KEY unchanged after first startup: LiteLLM uses it to
# encrypt provider credentials stored through the Admin UI.

LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=change-me-to-a-long-random-value
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me

POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me

# To use an existing PostgreSQL server instead of the bundled-db profile,
# uncomment this value. For a database running on the Docker host, use
# host.docker.internal and its host-side port.
# LITELLM_DATABASE_URL=postgresql://litellm:change-me@host.docker.internal:55432/litellm

# Optional provider credentials used by deploy/litellm/config.yaml.
OPENAI_API_KEY=
GEMINI_API_KEY=

# The gateway is bound to localhost by default.
LITELLM_BIND_ADDRESS=127.0.0.1
LITELLM_PORT=4000

# Override only when deliberately upgrading and testing images.
# LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
# POSTGRES_IMAGE=postgres:16-alpine
