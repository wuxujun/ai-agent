# Host port used to access the Prometheus web UI.
# Container-to-container traffic always uses prometheus:9090.
PROMETHEUS_PORT=9090
# Select the Langfuse-enabled Collector configuration. Without this setting,
# the local Jaeger/Tempo-only configuration is used and Compose commands such
# as `docker compose down` do not require Langfuse credentials.
OTEL_COLLECTOR_CONFIG_PATH=/etc/otelcol/config-langfuse.yaml
# Langfuse OTLP/HTTP trace ingestion. For a self-hosted deployment, append
# /api/public/otel to the externally reachable Langfuse base URL.
LANGFUSE_OTEL_ENDPOINT=https://langfuse.example.com/api/public/otel
# Complete HTTP Basic value: "Basic " followed by base64(public_key:secret_key).
LANGFUSE_OTEL_AUTHORIZATION="Basic replace-with-base64-public-key-colon-secret-key"
