    {
      "type": "timeseries",
      "title": "Replan Rate by Runtime",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (runtime) (rate(agent_multiagent_runtime_events_total{event=\"replanned\"}[15m])) / clamp_min(sum by (runtime) (rate(agent_multiagent_runtime_calls_total[15m])), 0.000001)",
          "refId": "A",
          "legendFormat": "{{runtime}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
